{
  "name": "@newt/cli",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "newt": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@newt/agents": "workspace:*",
    "@newt/base-sdk": "workspace:*",
    "@newt/base-xkmato": "workspace:*",
    "@newt/compiler": "workspace:*",
    "@newt/contract": "workspace:*"
  }
}
