+#[derive(Debug, serde::Deserialize)]
+struct SlotsForPrincipalRequest {
+    #[serde(default = "default_route_path")]
+    route: String,
+}
+
+fn default_route_path() -> String {
+    "/".to_string()
+}
+
+/// RFC-0003: Returns route-filtered `ResolvedSlotPayload[]` for a Bearer/cookie-authenticated
+/// principal so cookie-less SPAs can hydrate `<amphibian-slot>` anchors client-side.
+async fn handle_slots_for_principal(
+    State(state): State<Arc<ProxyState>>,
+    headers: HeaderMap,
+    Json(req): Json<SlotsForPrincipalRequest>,
+) -> impl IntoResponse {
+    let Some(principal) = state.identity.verify_headers(&headers).ok().flatten() else {
+        return (
+            StatusCode::UNAUTHORIZED,
+            [(header::CACHE_CONTROL, HeaderValue::from_static("private, no-store"))],
+            Json(serde_json::json!({ "error": "unauthenticated principal" })),
+        );
+    };
+
+    if state.is_kill_switch_active() {
+        return (
+            StatusCode::OK,
+            [(header::CACHE_CONTROL, HeaderValue::from_static("private, no-store"))],
+            Json(serde_json::json!({
+                "principal_uid": principal.uid,
+                "route": req.route,
+                "kill_switch": true,
+                "slots": []
+            })),
+        );
+    }
+
+    let mounts = state
+        .bindings
+        .get(&principal.uid)
+        .map(|b| filter_mounts_for_path(&req.route, &b.slot_mounts, None))
+        .unwrap_or_default();
+
+    (
+        StatusCode::OK,
+        [(header::CACHE_CONTROL, HeaderValue::from_static("private, no-store"))],
+        Json(serde_json::json!({
+            "principal_uid": principal.uid,
+            "route": req.route,
+            "kill_switch": false,
+            "slots": mounts
+        })),
+    )
+}
